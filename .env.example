# ── Base URL ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://yasminmedrano.com

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/yasmin_db
DATABASE_SSL=false

# ── Dashboard Auth ────────────────────────────────────────────────────────────
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=contraseña_segura_aqui
DASHBOARD_SECRET=secreto_largo_y_aleatorio_aqui

# ── Reseñas en Google ────────────────────────────────────────────────────────
# Enlace que da la ficha (Perfil de empresa → Pedir reseñas). Alimenta el enlace
# corto /resena y su QR. Sin valor, /resena lleva al formulario propio del sitio.
NEXT_PUBLIC_GOOGLE_REVIEW_URL=

# ── Analytics (opcional — sin valor, no se cargan los scripts) ───────────────
NEXT_PUBLIC_UMAMI_URL=https://analytics.yasminmedrano.com
NEXT_PUBLIC_UMAMI_WEBSITE_ID=9c6534a5-50b0-4f23-862e-f57c07cd4c64
NEXT_PUBLIC_META_PIXEL_ID=000000000000000
# ID del pixel de TikTok (TikTok Ads → Herramientas → Eventos). El valor real
# vive solo en el panel de despliegue.
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# ── Google Ads ───────────────────────────────────────────────────────────────
# ID de conversión de la cuenta (Google Ads → Objetivos → Conversiones). El
# valor real vive solo en el panel de despliegue.
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Etiqueta (label) de cada conversión: Google Ads → Objetivos → Conversiones →
# la acción → Instalar la etiqueta manualmente. Es la parte después de la "/"
# en send_to. Sin etiqueta NO se dispara la conversión (solo carga gtag.js).
NEXT_PUBLIC_GADS_LABEL_WHATSAPP=
NEXT_PUBLIC_GADS_LABEL_LEAD=
